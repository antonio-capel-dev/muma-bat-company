---
import BaseLayout from '../layouts/BaseLayout.astro'
import FormularioMuma from '../components/formularioContacto'

const porQueUnirte = [
  { titulo: 'Participa en Bat Nights', descripcion: 'Colabora en nuestras noches de avistamiento de murciélagos. Aprende detección acústica, conoce especies y vive la naturaleza nocturna de Málaga junto a un equipo científico.', img: '/images/Bat-Nigt-Malaga-1.webp' },
  { titulo: 'Instala refugios', descripcion: 'Ayuda a instalar y mantener refugios monitorizados para colonias de murciélagos. Una acción directa y tangible que mejora el hábitat de especies protegidas.', img: '/images/refugio_doble.webp' },
  { titulo: 'Investigación científica', descripcion: 'Participa en la recogida de datos de campo, monitorización de colonias y proyectos de ciencia ciudadana junto a biólogos especializados en quirópteros.', img: '/images/colonia_murcielago01.webp' },
  { titulo: 'Divulgación ambiental', descripcion: 'Apoya talleres educativos, eventos y experiencias VR. Comparte conocimiento sobre la importancia de los murciélagos en los ecosistemas mediterráneos.', img: '/images/educacion-ambiental.webp' },
]

const actividades = [
  { titulo: 'Monitorización de refugios', descripcion: 'Visitas periódicas a refugios instalados para registrar ocupación, especies y estado de las colonias. Datos reales que alimentan nuestra investigación.', img: '/images/monorefugios.webp' },
  { titulo: 'Apoyo en eventos VR', descripcion: 'Asistencia técnica y de atención al público en nuestras experiencias de realidad virtual. Guías de la experiencia MuMa BAT CAVE para visitantes y grupos escolares.', img: '/images/apoyo-eventos-vr-voluntarios.webp' },
  { titulo: 'Detección de ultrasonidos', descripcion: 'Uso de detectores acústicos durante salidas nocturnas para identificar especies de murciélagos por su ecolocalización. Formación incluida.', img: '/images/ultrasonidos.webp' },
  { titulo: 'Talleres educativos', descripcion: 'Colaboración en la impartición de talleres en colegios, institutos y centros cívicos. Transmite el value ecológico de los murciélagos a nuevas generaciones.', img: '/images/tallerrefugios.webp' },
]

const requisitos = [
  'Ninguna formación específica requerida',
  'Solo motivación y compromiso con la naturaleza',
  'Disponibilidad ocasional, adaptable a tu agenda',
  'Mayores de 16 años (menores con autorización)'
]
---
<BaseLayout title="Voluntariado | MUMA BAT COMPANY" description="Únete al equipo de voluntarios de MUMA BAT COMPANY. Participa en Bat Nights, instalación de refugios e investigación científica de murciélagos en Málaga.">
  <main class="min-h-screen bg-fondo-base text-white">

    <section class="relative min-h-[70vh] flex flex-col justify-center items-center text-center px-6 pt-28 pb-16 overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/fondovoluntario.webp')" aria-hidden="true"></div>
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(11,17,23,0.65) 0%, rgba(11,17,23,0.55) 50%, rgba(11,17,23,0.80) 100%)" aria-hidden="true"></div>
      <div class="relative z-10 max-w-3xl mx-auto">
        <p class="text-xs font-semibold tracking-widest text-marca-principal uppercase mb-5">Únete al equipo</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight text-texto-titulo mb-6">
          Únete como <span class="text-marca-principal">voluntario</span>
        </h1>
        <p class="text-lg sm:text-xl text-texto-secundario max-w-2xl mx-auto leading-relaxed mb-10">
          Protege la biodiversidad de Málaga desde el terreno. Con MUMA puedes participar activamente en la conservación de murciélagos, la investigación científica y la divulgación ambiental en la Costa del Sol.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="#formulario" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-semibold bg-marca-principal text-texto-sobre-accion hover:bg-marca-principal-hover transition-colors duration-200 no-underline">
            Quiero ser voluntario
          </a>
          <a href="#actividades" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-sm font-semibold border border-white/15 text-texto-principal hover:bg-fondo-superficie hover:border-white/25 transition-all duration-200 no-underline">
            Ver actividades →
          </a>
        </div>
      </div>
    </section>

    <section class="bg-fondo-secundario py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold tracking-widest text-marca-principal uppercase mb-3">Razones para sumarte</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-texto-titulo mb-4">¿Por qué ser voluntario en MUMA?</h2>
          <p class="text-texto-secundario max-w-xl mx-auto">Más que ayudar, aprenderás, vivirás la ciencia en primera persona y formarás parte de un proyecto con impacto real en la biodiversidad malagueña.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {porQueUnirte.map((item) => (
            <article class="bg-fondo-superficie rounded-2xl border border-white/5 hover:border-purple-400 transition-colors duration-300 overflow-hidden flex flex-col">
              <div class="aspect-video overflow-hidden">
                <img src={item.img} alt={item.titulo} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-6 flex flex-col grow">
                <h3 class="text-base font-bold text-marca-principal mb-3 leading-snug">{item.titulo}</h3>
                <p class="text-sm text-texto-secundario leading-relaxed grow">{item.descripcion}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="actividades" class="bg-fondo-base py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <p class="text-xs font-semibold tracking-widest text-marca-principal uppercase mb-3">En el día a día</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-texto-titulo mb-4">¿Qué hacen los voluntarios?</h2>
          <p class="text-texto-secundario max-w-xl mx-auto">Actividades concretas, variadas y con impacto directo en la conservación de los murciélagos en Málaga.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {actividades.map((item) => (
            <div class="bg-fondo-superficie rounded-2xl border border-white/5 hover:border-purple-400 transition-colors duration-300 overflow-hidden flex flex-col">
              <div class="aspect-video overflow-hidden">
                <img src={item.img} alt={item.titulo} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-7">
                <div>
                  <h3 class="text-base font-bold text-marca-principal mb-2 leading-snug">{item.titulo}</h3>
                  <p class="text-sm text-texto-secundario leading-relaxed">{item.descripcion}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-fondo-secundario py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <p class="text-xs font-semibold tracking-widest text-marca-principal uppercase mb-3">Abierto a todos</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-texto-titulo mb-4">Requisitos</h2>
          <p class="text-texto-secundario max-w-xl mx-auto">No necesitas experiencia previa ni formación específica. Solo ganas de aprender y cuidar el entorno natural.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
          {requisitos.map((req) => (
            <div class="flex gap-3 items-start bg-fondo-superficie rounded-xl p-5 border border-white/5">
              <span class="shrink-0 w-5 h-5 mt-0.5 rounded-full bg-marca-principal/15 flex items-center justify-center">
                <span class="w-2 h-2 rounded-full bg-marca-principal block" aria-hidden="true" />
              </span>
              <p class="text-sm text-texto-secundario leading-relaxed">{req}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="formulario" class="bg-fondo-base py-20 px-6">
      <div class="max-w-xl mx-auto">
        <div class="text-center mb-10">
          <p class="text-xs font-semibold tracking-widest text-marca-principal uppercase mb-3">Primer paso</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-texto-titulo mb-4">Escríbenos</h2>
          <p class="text-texto-secundario leading-relaxed">Cuéntanos quién eres y qué te motiva a unirte. Te responderemos en menos de 48 horas.</p>
        </div>

        <FormularioMuma 
          client:visible
          tablaBD="consultas_web"
          asuntoCorreo="[Web Voluntarios] Nueva solicitud de unión"
          textoBoton="ENVIAR SOLICITUD"
          mostrarOrganizacion={false}
          mostrarTelefono={false}
          mostrarMensaje={true}
          placeholderMensaje="Cuéntanos qué te motiva a ser voluntario y en qué actividades te gustaría participar…"
          mostrarSelect={false}
          mostrarFecha={false}
          mostrarParticipantes={false}
          nombreCampoNombre="nombre_contacto"
          camposOcultos={{
            tipo_solicitud: 'voluntariado',
            origen: 'web_voluntarios'
          }}
        />
      </div>
    </section>

    <section class="bg-fondo-secundario py-20 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-marca-principal/10 border border-marca-principal/20 mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-marca-principal"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-texto-titulo mb-5 leading-tight">
          Quiero ser <span class="text-marca-principal">voluntario</span>
        </h2>
        <p class="text-lg text-texto-secundario leading-relaxed mb-10 max-w-xl mx-auto">
          Cada persona que se une a MUMA contribuye a proteger una especie fundamental para el ecosistema mediterráneo. Tu compromiso marca la diferencia.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="#formulario" class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-semibold bg-marca-principal text-texto-sobre-accion hover:bg-marca-principal-hover transition-colors duration-200 no-underline">
            Apuntarme ahora
          </a>
        </div>
        <p class="mt-8 text-sm text-texto-secundario/60">
          ¿Prefieres donar? <a href="/donar" class="text-marca-principal hover:opacity-80 transition-opacity duration-200 no-underline">Apoya MUMA económicamente</a>
        </p>
      </div>
    </section>

  </main>
</BaseLayout>
