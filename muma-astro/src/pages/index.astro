---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/astro/Hero.astro';
import Credibilidad from '../components/astro/Credibilidad.astro';
import Diferenciacion from '../components/astro/Diferenciacion.astro';
import Segmentacion from '../components/astro/Segmentacion.astro';
import Servicios from '../components/astro/Servicios.astro';
import ProximosEventos from '../components/astro/ProximosEventos.astro';
import Vision from '../components/astro/Vision.astro';
import Captacion from '../components/astro/Captacion.astro';
import CTAFinal from '../components/astro/CTAFinal.astro';
---

<BaseLayout
  title="MUMA BAT COMPANY | Ciencia, Tecnología y Conservación"
  description="Empresa especializada en conservación de quirópteros. Batcave Experience, Bat Nights, Refugios y Consultoría bioacústica con respaldo europeo ST3ER."
>
  <main class="bg-[#050505] min-h-screen selection:bg-[#10b981] selection:text-black">
    <Hero />
    <Credibilidad />
    <Diferenciacion />
    <Segmentacion />
    <Servicios />
    <ProximosEventos />
    <Vision />
    <Captacion />
    <CTAFinal />
  </main>
</BaseLayout>
